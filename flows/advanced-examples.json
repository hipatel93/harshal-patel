    {
        "id": "form-processor",
        "type": "function",
        "z": "advanced-tab",
        "name": "Process Form Data",
        "func": "// Process form submission\nvar formData = msg.payload;\n\n// Validate and process the form data\nvar config = {\n    deviceName: formData.deviceName || 'Unknown Device',\n    location: formData.location || 'Unknown Location',\n    samplingRate: parseInt(formData.samplingRate) || 5,\n    alertsEnabled: formData.alertsEnabled === true || formData.alertsEnabled === 'true',\n    temperatureThreshold: parseFloat(formData.temperatureThreshold) || 25,\n    humidityThreshold: parseFloat(formData.humidityThreshold) || 70,\n    configuredAt: new Date().toISOString()\n};\n\n// Store configuration in global context\nglobal.set('deviceConfig', config);\n\n// Prepare response message\nmsg.payload = {\n    success: true,\n    message: 'Device configuration updated successfully',\n    config: config\n};\n\nmsg.topic = 'device/config/response';\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 300,
        "wires": [
            [
                "ui-notification"
