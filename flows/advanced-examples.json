        "id": "ui-template-weather",
        "type": "ui-template",
        "z": "advanced-tab",
        "group": "ui-group-api",
        "order": 1,
        "width": 0,
        "height": 0,
        "name": "Weather Display",
        "label": "Current Weather",
        "format": "<div style=\"padding: 15px; background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%); color: white; border-radius: 10px; text-align: center;\">\n  <h3 style=\"margin-top: 0;\">🌤️ {{msg.payload.city}}, {{msg.payload.country}}</h3>\n  <div style=\"font-size: 2em; margin: 10px 0;\">{{msg.payload.temperature}}°C</div>\n  <div style=\"text-transform: capitalize; margin-bottom: 15px;\">{{msg.payload.description}}</div>\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 0.9em;\">\n    <div>💧 Humidity: {{msg.payload.humidity}}%</div>\n    <div>🌬️ Wind: {{msg.payload.windSpeed}} m/s</div>\n    <div>🌡️ Feels like: {{msg.payload.feelsLike}}°C</div>\n    <div>📊 Pressure: {{msg.payload.pressure}} hPa</div>\n  </div>\n  <div style=\"margin-top: 10px; font-size: 0.8em; opacity: 0.8;\">\n    Last updated: {{msg.payload.timestamp}}\n  </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": false,
        "templateScope": "local",
        "className": "",
        "x": 800,
        "y": 400,
