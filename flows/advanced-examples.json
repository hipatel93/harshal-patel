    {
        "id": "city-validator",
        "type": "function",
        "z": "advanced-tab",
        "name": "Validate City",
        "func": "// Validate city input\nvar city = msg.payload;\n\n// Basic validation\nif (!city || city.trim().length < 2) {\n    node.warn('Invalid city name');\n    return null;\n}\n\n// Clean and format city name\ncity = city.trim().toLowerCase()\n    .split(' ')\n    .map(word => word.charAt(0).toUpperCase() + word.slice(1))\n    .join(' ');\n\nmsg.payload = city;\nmsg.topic = 'weather/city/validated';\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 480,
        "wires": [
            [
                "http-request"
            ]
        ]
    }
