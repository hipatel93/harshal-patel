    {
        "id": "sensor-simulator",
        "type": "function",
        "z": "advanced-tab",
        "name": "Sensor Data Simulator",
        "func": "// Simulate sensor data\nvar timestamp = new Date();\nvar baseTemp = 20;\nvar baseHumidity = 50;\nvar basePressure = 1013;\n\n// Add some randomness\nvar temp = baseTemp + (Math.random() - 0.5) * 10;\nvar humidity = Math.max(0, Math.min(100, baseHumidity + (Math.random() - 0.5) * 20));\nvar pressure = basePressure + (Math.random() - 0.5) * 20;\n\n// Create sensor data object\nvar sensorData = {\n    timestamp: timestamp.toISOString(),\n    temperature: Math.round(temp * 10) / 10,\n    humidity: Math.round(humidity * 10) / 10,\n    pressure: Math.round(pressure * 10) / 10,\n    location: \"Room 1\"\n};\n\nmsg.payload = sensorData;\nmsg.topic = \"sensors/environmental\";\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 100,
        "wires": [
            [
                "ui-chart-temp",
                "ui-chart-humidity",
                "ui-chart-pressure",
                "data-storage"
            ]
        ]
    },
