    {
        "id": "data-storage",
        "type": "function",
        "z": "advanced-tab",
        "name": "Store Data",
        "func": "// Store data in global context for historical access\nvar data = msg.payload;\nvar history = global.get('sensorHistory') || [];\n\n// Add new data point\nhistory.push(data);\n\n// Keep only last 100 points\nif (history.length > 100) {\n    history = history.slice(-100);\n}\n\n// Store back in global context\nglobal.set('sensorHistory', history);\n\n// Calculate statistics\nvar temps = history.map(h => h.temperature);\nvar avgTemp = temps.reduce((a, b) => a + b, 0) / temps.length;\nvar maxTemp = Math.max(...temps);\nvar minTemp = Math.min(...temps);\n\n// Prepare statistics message\nmsg.payload = {\n    current: data,\n    statistics: {\n        averageTemperature: Math.round(avgTemp * 10) / 10,\n        maxTemperature: maxTemp,\n        minTemperature: minTemp,\n        dataPoints: history.length\n    },\n    timestamp: new Date().toISOString()\n};\n\nmsg.topic = 'sensors/statistics';\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 200,
        "wires": [
            [
                "ui-template-stats"
            ]
        ]
    },
    {
        "id": "ui-template-stats",
        "type": "ui-template",
        "z": "advanced-tab",
        "group": "ui-group-charts",
        "order": 4,
        "width": 0,
        "height": 0,
        "name": "Statistics Display",
        "label": "Sensor Statistics",
        "format": "<div style=\"padding: 15px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 10px; margin: 10px 0;\">\n  <h3 style=\"margin-top: 0;\">📊 Sensor Statistics</h3>\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px;\">\n    <div>\n      <strong>🌡️ Temperature</strong><br>\n      Current: {{msg.payload.current.temperature}}°C<br>\n      Average: {{msg.payload.statistics.averageTemperature}}°C<br>\n      Range: {{msg.payload.statistics.minTemperature}}°C - {{msg.payload.statistics.maxTemperature}}°C\n    </div>\n    <div>\n      <strong>💧 Humidity</strong><br>\n      Current: {{msg.payload.current.humidity}}%<br>\n      <strong>🌬️ Pressure</strong><br>\n      Current: {{msg.payload.current.pressure}} hPa\n    </div>\n  </div>\n  <div style=\"margin-top: 10px; font-size: 0.9em; opacity: 0.8;\">\n    Data points: {{msg.payload.statistics.dataPoints}} | Last updated: {{msg.payload.timestamp}}\n  </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": false,
        "templateScope": "local",
        "className": "",
        "x": 600,
        "y": 200,
        "wires": [
            []
        ]
    },
    {
        "id": "ui-form",
        "type": "ui-form",
        "z": "advanced-tab",
        "name": "Device Configuration",
        "label": "Configure Device",
        "group": "ui-group-forms",
        "order": 1,
        "width": 0,
        "height": 0,
        "formValue": "{\n  \"deviceName\": \"Sensor Node 1\",\n  \"location\": \"Living Room\",\n  \"samplingRate\": 5,\n  \"alertsEnabled\": true,\n  \"temperatureThreshold\": 25,\n  \"humidityThreshold\": 70\n}",
        "payload": "",
        "submit": "submit",
        "cancel": "cancel",
        "topic": "device/config",
        "topicType": "str",
        "splitLayout": "",
        "className": "",
        "x": 200,
        "y": 300,
        "wires": [
            [
                "form-processor"
            ]
