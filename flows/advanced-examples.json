    {
        "id": "http-request",
        "type": "http request",
        "z": "advanced-tab",
        "name": "Weather API",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "https://api.openweathermap.org/data/2.5/weather?q={{msg.payload}}&appid=demo&units=metric",
        "tls": "",
        "persist": false,
        "proxy": "",
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 400,
        "y": 400,
        "wires": [
            [
                "weather-processor"
            ]
        ]
    },
    {
        "id": "weather-processor",
        "type": "function",
        "z": "advanced-tab",
        "name": "Process Weather Data",
        "func": "// Process weather API response\nvar weather = msg.payload;\n\n// Extract relevant information\nvar weatherData = {\n    city: weather.name,\n    country: weather.sys.country,\n    temperature: Math.round(weather.main.temp * 10) / 10,\n    feelsLike: Math.round(weather.main.feels_like * 10) / 10,\n    humidity: weather.main.humidity,\n    pressure: weather.main.pressure,\n    description: weather.weather[0].description,\n    icon: weather.weather[0].icon,\n    windSpeed: weather.wind.speed,\n    windDirection: weather.wind.deg,\n    timestamp: new Date().toISOString()\n};\n\n// Prepare message for dashboard\nmsg.payload = weatherData;\nmsg.topic = 'weather/current';\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 400,
        "wires": [
            [
                "ui-template-weather"
            ]
        ]
    },
