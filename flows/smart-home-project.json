        "id": "security-processor",
        "type": "function",
        "z": "smart-home-tab",
        "name": "Process Security Control",
        "func": "// Get current smart home state\nvar state = global.get('smartHomeState') || {};\nvar alarmState = msg.payload === 'armed';\n\n// Update security settings\nif (state.security) {\n    state.security.alarmArmed = alarmState;\n    \n    // Update timestamp\n    state.system.lastUpdate = new Date().toISOString();\n    \n    // Store updated state\n    global.set('smartHomeState', state);\n    \n    // Prepare response\n    msg.payload = {\n        success: true,\n        security: state.security,\n        timestamp: state.system.lastUpdate\n    };\n    \n    msg.topic = 'security/status';\n} else {\n    msg.payload = {\n        success: false,\n        error: 'Security system not initialized'\n    };\n}\n\nreturn msg;",
        "outputs": 1,
