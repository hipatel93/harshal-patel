    {
        "id": "light-processor",
        "type": "function",
        "z": "smart-home-tab",
        "name": "Process Light Control",
        "func": "// Get current smart home state\nvar state = global.get('smartHomeState') || {};\nvar control = msg.payload;\n\n// Process light control\nif (state.lights && state.lights[control.room]) {\n    if (control.action === 'toggle') {\n        state.lights[control.room].state = !state.lights[control.room].state;\n    } else if (control.action === 'set') {\n        state.lights[control.room].state = control.state;\n        if (control.brightness) state.lights[control.room].brightness = control.brightness;\n        if (control.color) state.lights[control.room].color = control.color;\n    }\n    \n    // Update timestamp\n    state.system.lastUpdate = new Date().toISOString();\n    \n    // Store updated state\n    global.set('smartHomeState', state);\n    \n    // Prepare response\n    msg.payload = {\n        success: true,\n        room: control.room,\n        light: state.lights[control.room],\n        timestamp: state.system.lastUpdate\n    };\n    \n    msg.topic = 'lights/status';\n} else {\n    msg.payload = {\n        success: false,\n        error: 'Room not found'\n    };\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 200,
        "wires": [
