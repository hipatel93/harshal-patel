    {
        "id": "init-system",
        "type": "function",
        "z": "smart-home-tab",
        "name": "Initialize Smart Home",
        "func": "// Initialize smart home system with default values\nvar smartHomeState = {\n    lights: {\n        livingRoom: { state: false, brightness: 100, color: '#ffffff' },\n        bedroom: { state: false, brightness: 80, color: '#ffffff' },\n        kitchen: { state: false, brightness: 100, color: '#ffffff' },\n        bathroom: { state: false, brightness: 60, color: '#ffffff' }\n    },\n    climate: {\n        temperature: 22,\n        targetTemp: 22,\n        humidity: 45,\n        fanSpeed: 0,\n        acMode: 'auto'\n    },\n    security: {\n        alarmArmed: false,\n        doorLocked: true,\n        motionDetected: false,\n        lastMotion: null\n    },\n    energy: {\n        currentUsage: 0,\n        dailyUsage: 0,\n        monthlyUsage: 0,\n        solarProduction: 0\n    },\n    system: {\n        lastUpdate: new Date().toISOString(),\n        version: '1.0.0',\n        status: 'online'\n    }\n};\n\n// Store in global context\nglobal.set('smartHomeState', smartHomeState);\n\n// Prepare initialization message\nmsg.payload = {\n    message: 'Smart Home System Initialized',\n    state: smartHomeState\n};\n\nmsg.topic = 'system/initialized';\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 100,
        "wires": [
            [
                "ui-template-overview"
            ]
        ]
    },
    {
        "id": "ui-template-overview",
        "type": "ui-template",
        "z": "smart-home-tab",
        "group": "ui-group-overview",
        "order": 1,
        "width": 0,
        "height": 0,
        "name": "Home Overview",
        "label": "Smart Home Status",
        "format": "<div style=\"padding: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 15px; margin: 10px 0;\">\n  <h2 style=\"margin-top: 0; text-align: center;\">🏠 Smart Home Dashboard</h2>\n  <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-top: 20px;\">\n    <div style=\"background: rgba(255,255,255,0.1); padding: 15px; border-radius: 10px; text-align: center;\">\n      <h3>💡 Lighting</h3>\n      <div id=\"light-status\">Loading...</div>\n    </div>\n    <div style=\"background: rgba(255,255,255,0.1); padding: 15px; border-radius: 10px; text-align: center;\">\n      <h3>🌡️ Climate</h3>\n      <div id=\"climate-status\">Loading...</div>\n    </div>\n    <div style=\"background: rgba(255,255,255,0.1); padding: 15px; border-radius: 10px; text-align: center;\">\n      <h3>🔒 Security</h3>\n      <div id=\"security-status\">Loading...</div>\n    </div>\n    <div style=\"background: rgba(255,255,255,0.1); padding: 15px; border-radius: 10px; text-align: center;\">\n      <h3>⚡ Energy</h3>\n      <div id=\"energy-status\">Loading...</div>\n    </div>\n  </div>\n  <div style=\"text-align: center; margin-top: 20px; font-size: 0.9em; opacity: 0.8;\">\n    System Status: <span id=\"system-status\">Online</span> | Last Update: <span id=\"last-update\">{{msg.payload.state.system.lastUpdate}}</span>\n  </div>\n</div>\n\n<script>\n// Update status displays when data changes\n(function(scope) {\n    scope.$watch('msg', function(msg) {\n        if (msg && msg.payload && msg.payload.state) {\n            var state = msg.payload.state;\n            \n            // Update lighting status\n            var lightsOn = Object.values(state.lights).filter(light => light.state).length;\n            var totalLights = Object.keys(state.lights).length;\n            document.getElementById('light-status').innerHTML = lightsOn + '/' + totalLights + ' lights on';\n            \n            // Update climate status\n            document.getElementById('climate-status').innerHTML = state.climate.temperature + '°C (Target: ' + state.climate.targetTemp + '°C)';\n            \n            // Update security status\n            var securityStatus = state.security.alarmArmed ? 'Armed' : 'Disarmed';\n            document.getElementById('security-status').innerHTML = securityStatus;\n            \n            // Update energy status\n            document.getElementById('energy-status').innerHTML = state.energy.currentUsage + 'W';\n            \n            // Update system status\n            document.getElementById('system-status').innerHTML = state.system.status;\n            document.getElementById('last-update').innerHTML = new Date(state.system.lastUpdate).toLocaleTimeString();\n        }\n    });\n})(scope);\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": false,
        "templateScope": "local",
        "className": "",
        "x": 600,
        "y": 100,
        "wires": [
            []
        ]
    },
