        "func": "// Process system settings\nvar settings = msg.payload;\nvar state = global.get('smartHomeState') || {};\n\n// Update system settings\nif (!state.system) state.system = {};\nstate.system.name = settings.systemName || 'Smart Home';\nstate.system.location = settings.location || 'Home';\nstate.system.timezone = settings.timezone || 'UTC';\nstate.system.autoMode = settings.autoMode === true || settings.autoMode === 'true';\nstate.system.notifications = settings.notifications === true || settings.notifications === 'true';\nstate.system.energySaving = settings.energySaving === true || settings.energySaving === 'true';\nstate.system.lastUpdate = new Date().toISOString();\n\n// Store updated state\nglobal.set('smartHomeState', state);\n\n// Prepare response\nmsg.payload = {\n    success: true,\n    message: 'System settings updated successfully',\n    settings: state.system\n};\n\nmsg.topic = 'system/settings/response';\n\nreturn msg;",
