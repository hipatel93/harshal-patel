    {
        "id": "energy-monitor",
        "type": "inject",
        "z": "smart-home-tab",
        "name": "Update Energy",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "5",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 150,
        "y": 500,
