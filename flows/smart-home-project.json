    {
        "id": "climate-processor",
        "type": "function",
        "z": "smart-home-tab",
        "name": "Process Climate Control",
        "func": "// Get current smart home state\nvar state = global.get('smartHomeState') || {};\nvar targetTemp = msg.payload;\n\n// Update climate settings\nif (state.climate) {\n    state.climate.targetTemp = targetTemp;\n    \n    // Simulate temperature adjustment\n    var currentTemp = state.climate.temperature;\n    var diff = targetTemp - currentTemp;\n    \n    if (Math.abs(diff) > 0.5) {\n        state.climate.temperature += diff * 0.1; // Gradual adjustment\n    }\n    \n    // Update fan speed based on temperature difference\n    if (Math.abs(diff) > 2) {\n        state.climate.fanSpeed = Math.min(100, Math.abs(diff) * 20);\n    } else {\n        state.climate.fanSpeed = 0;\n    }\n    \n    // Update timestamp\n    state.system.lastUpdate = new Date().toISOString();\n    \n    // Store updated state\n    global.set('smartHomeState', state);\n    \n    // Prepare response\n    msg.payload = {\n        success: true,\n        climate: state.climate,\n        timestamp: state.system.lastUpdate\n    };\n    \n    msg.topic = 'climate/status';\n} else {\n    msg.payload = {\n        success: false,\n        error: 'Climate system not initialized'\n    };\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 300,
