    {
        "id": "energy-simulator",
        "type": "function",
        "z": "smart-home-tab",
        "name": "Energy Usage Simulator",
        "func": "// Get current smart home state\nvar state = global.get('smartHomeState') || {};\n\n// Simulate energy usage based on current state\nvar baseUsage = 50; // Base usage in watts\nvar lightUsage = 0;\nvar climateUsage = 0;\n\n// Calculate light usage\nif (state.lights) {\n    Object.values(state.lights).forEach(light => {\n        if (light.state) {\n            lightUsage += light.brightness * 0.1; // 0.1W per brightness unit\n        }\n    });\n}\n\n// Calculate climate usage\nif (state.climate) {\n    climateUsage = state.climate.fanSpeed * 0.5; // 0.5W per fan speed unit\n    if (Math.abs(state.climate.targetTemp - state.climate.temperature) > 1) {\n        climateUsage += 100; // AC/Heating usage\n    }\n}\n\n// Update energy data\nif (state.energy) {\n    state.energy.currentUsage = Math.round(baseUsage + lightUsage + climateUsage);\n    state.energy.dailyUsage += state.energy.currentUsage * 0.001; // Convert to kWh\n    state.energy.solarProduction = Math.random() * 200; // Simulate solar production\n    \n    // Update timestamp\n    state.system.lastUpdate = new Date().toISOString();\n    \n    // Store updated state\n    global.set('smartHomeState', state);\n    \n    // Prepare response\n    msg.payload = {\n        success: true,\n        energy: state.energy,\n        timestamp: state.system.lastUpdate\n    };\n    \n    msg.topic = 'energy/status';\n} else {\n    msg.payload = {\n        success: false,\n        error: 'Energy monitoring not initialized'\n    };\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 500,
        "wires": [
            [
                "ui-gauge-energy",
                "ui-chart-energy",
                "update-overview"
            ]
        ]
