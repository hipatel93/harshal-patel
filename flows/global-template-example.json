    {
        "id": "global-data-processor",
        "type": "function",
        "z": "global-template-tab",
        "name": "Process Global Data",
        "func": "// Generate sample data for global template demonstration\nvar globalData = {\n    message: \"Global template system initialized\",\n    timestamp: new Date().toISOString(),\n    version: \"1.0.0\",\n    features: [\n        \"Global template functions\",\n        \"Shared CSS styles\",\n        \"Cross-template communication\",\n        \"Reusable components\"\n    ]\n};\n\n// Prepare message\nmsg.payload = globalData;\nmsg.topic = \"global/init\";\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 100,
        "wires": [
            [
                "ui-template-global-definition",
                "ui-template-global-usage",
                "ui-template-global-styles"
            ]
        ]
    },
    {
        "id": "global-action-processor",
        "type": "function",
        "z": "global-template-tab",
        "name": "Process Global Actions",
        "func": "// Process actions from global templates\nvar action = msg.payload;\n\n// Log the action\nnode.log(`Global Action: ${action.action} on line ${action.lineKey}`);\n\n// Process specific actions\nswitch (action.action) {\n    case 'editorder':\n    case 'edit':\n        msg.payload = {\n            success: true,\n            message: 'Edit action processed via global template',\n            action: action.action,\n            lineKey: action.lineKey,\n            timestamp: new Date().toISOString()\n        };\n        break;\n        \n    case 'deleteorder':\n    case 'delete':\n        msg.payload = {\n            success: true,\n            message: 'Delete action processed via global template',\n            action: action.action,\n            lineKey: action.lineKey,\n            timestamp: new Date().toISOString()\n        };\n        break;\n        \n    case 'markdone':\n        msg.payload = {\n            success: true,\n            message: 'Mark done action processed via global template',\n            action: action.action,\n            lineKey: action.lineKey,\n            timestamp: new Date().toISOString()\n        };\n        break;\n        \n    case 'run':\n    case 'RunOrder':\n        msg.payload = {\n            success: true,\n            message: 'Run action processed via global template',\n            action: action.action,\n            lineKey: action.lineKey,\n            timestamp: new Date().toISOString()\n        };\n        break;\n        \n    default:\n        msg.payload = {\n            success: false,\n            message: 'Unknown global action',\n            action: action.action,\n            timestamp: new Date().toISOString()\n        };\n}\n\nmsg.topic = `global/action/${action.action}`;\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 100,
        "wires": [
